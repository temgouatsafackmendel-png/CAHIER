# ==============================================================================
# Configuration de l'application Cahier (Prise et Organisation de Notes)
# Aucun secret réel ne doit jamais être commité dans ce fichier ni dans Git.
# ==============================================================================

# Port du serveur HTTP (par défaut 3000 dans l'environnement d'exécution)
PORT=3000

# Environnement d'exécution (development | test | production)
NODE_ENV=development

# Chemin vers le fichier de base de données SQLite persistante
# Utilisez ":memory:" uniquement pour les tests automatisés isolés
SQLITE_DB_PATH="./data/notes.sqlite"

# Limite de requêtes par fenêtre de 60 secondes par IP sur l'API
RATE_LIMIT_MAX_REQUESTS=180

# GEMINI_API_KEY: Injecté par la plateforme si nécessaire (non requis pour le cœur de prise de notes)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publique de l'application
APP_URL="http://localhost:3000"
